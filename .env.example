# Server
PORT=4000
NODE_ENV=development

# MongoDB (local)
MONGO_URI=mongodb://127.0.0.1:27017/ugopeters

# CORS — frontend origin (Vite dev server default)
CLIENT_URL=http://localhost:5173

# Admin auth (CMS) — REQUIRED. Use a long random string for JWT_SECRET in prod.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Seed script credentials (npm run seed:admin). Match the frontend demo login by default.
ADMIN_NAME=Ugo Peters
ADMIN_EMAIL=admin@ugopeters.com
ADMIN_PASSWORD=admin123

# Cloudinary (blog image uploads) — REQUIRED for POST /api/upload. From your
# Cloudinary dashboard. CLOUDINARY_FOLDER is where assets are stored.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ugopeters/blog

# Feature vars are added here as their features land:
#   RESEND_API_KEY=        (contact/newsletter email)
#   RESEND_EMAIL=
