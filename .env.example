# Server
PORT=4000
NODE_ENV=development

# MongoDB (local)
MONGO_URI=mongodb://127.0.0.1:27017/ugopeters

# Canonical site URL. Used to build links in outgoing email, so keep it a
# single origin (no list). In production: https://www.ugopeters.net
CLIENT_URL=http://localhost:5173

# Browser origins allowed to call the API with credentials. Comma-separated,
# no trailing slashes. Optional — when unset it falls back to CLIENT_URL plus
# the known production hosts. Set it to override that list entirely, e.g.
# CORS_ORIGINS=https://www.ugopeters.net,https://ugopeters.net
CORS_ORIGINS=

# Admin auth (CMS) — REQUIRED. Use a long random string for JWT_SECRET in prod.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Seed script credentials (npm run seed:admin). Match the frontend demo login by default.
ADMIN_NAME=Ugo Peters
ADMIN_EMAIL=admin@ugopeters.com
ADMIN_PASSWORD=admin123

# Cloudinary (blog image uploads) — REQUIRED for POST /api/upload. From your
# Cloudinary dashboard. CLOUDINARY_FOLDER is where assets are stored.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ugopeters/blog

# Email (contact + newsletter notifications). All OPTIONAL — if unset, emails are
# skipped (logged), and contact/subscribe still succeed. Resend is tried first,
# then SMTP. EMAIL_FROM must use a Resend-verified domain in prod; the default
# onboarding@resend.dev works for testing with any Resend account.
RESEND_API_KEY=
EMAIL_FROM=Ugo Peters <onboarding@resend.dev>
# Where contact-form + new-subscriber notifications are sent (defaults to ADMIN_EMAIL).
CONTACT_NOTIFY_EMAIL=
# SMTP fallback (used only when RESEND_API_KEY is empty).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
